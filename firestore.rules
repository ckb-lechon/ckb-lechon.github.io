rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function productPath(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }
    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function canAccessOrderMessages(orderId) {
      return signedIn()
        && (isAdmin()
          || get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
    }
    function validProduct() {
      return request.resource.data.orderName in [
          'Belly',
          'Belly Bilao',
          'Belly Bilao Food Package',
          'Karne Kinilo',
          'Lechon Food Package',
          'Lechon Kinilo',
          'Tray',
          'Whole Lechon'
        ]
        && request.resource.data.name == request.resource.data.orderName
        && request.resource.data.description is string
        && (!request.resource.data.keys().hasAny(['food']) || request.resource.data.food is list)
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && (request.resource.data.orderName != 'Whole Lechon'
          || (request.resource.data.get('kiloPrices', {}) is map
            && request.resource.data.get('kiloPrices', {}).size() > 0))
        && (!request.resource.data.keys().hasAny(['stock'])
          || (request.resource.data.orderName in ['Lechon Kinilo', 'Karne Kinilo']
            && request.resource.data.stock is number
            && request.resource.data.stock >= 0))
        && request.resource.data.saleType in ['regular', 'promo']
        && (request.resource.data.saleType == 'regular'
          || (request.resource.data.keys().hasAll(['promoFrom', 'promoTo'])
            && request.resource.data.promoFrom is string
            && request.resource.data.promoTo is string
            && request.resource.data.promoFrom.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.promoTo.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.promoFrom <= request.resource.data.promoTo))
        && request.resource.data.imageUrl is string
        && request.resource.data.active is bool;
    }
    function allowsDecimalQuantity(orderName) {
      return orderName in ['Lechon Kinilo', 'Karne Kinilo'];
    }
    function validStockDeduction(productId) {
      let orderId = request.resource.data.get('lastStockOrderId', '');
      let stock = resource.data.get('stock', -1);
      let nextStock = request.resource.data.get('stock', -1);
      let orderAfter = getAfter(orderPath(orderId)).data;
      return signedIn()
        && orderId is string
        && request.resource.data.keys().hasAll(['stock', 'lastStockOrderId'])
        && allowsDecimalQuantity(resource.data.get('orderName', resource.data.get('name', '')))
        && stock is number
        && nextStock is number
        && nextStock >= 0
        && nextStock < stock
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastStockOrderId'])
        && orderAfter.userId == request.auth.uid
        && orderAfter.productId == productId
        && orderAfter.status == 'pending'
        && orderAfter.stockDeducted == true
        && orderAfter.quantity == stock - nextStock;
    }
    function validStockRestock(productId) {
      let orderId = request.resource.data.get('lastStockOrderId', '');
      let stock = resource.data.get('stock', -1);
      let nextStock = request.resource.data.get('stock', -1);
      let orderBefore = get(orderPath(orderId)).data;
      let orderAfter = getAfter(orderPath(orderId)).data;
      return signedIn()
        && orderId is string
        && request.resource.data.keys().hasAll(['stock', 'lastStockOrderId'])
        && allowsDecimalQuantity(resource.data.get('orderName', resource.data.get('name', '')))
        && stock is number
        && nextStock is number
        && nextStock == stock + orderBefore.quantity
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastStockOrderId'])
        && orderBefore.userId == request.auth.uid
        && orderBefore.productId == productId
        && orderBefore.status == 'pending'
        && orderBefore.stockDeducted == true
        && orderAfter.userId == request.auth.uid
        && orderAfter.productId == productId
        && orderAfter.status == 'cancelled'
        && orderAfter.stockDeducted == true
        && orderAfter.quantity == orderBefore.quantity;
    }
    function validOrder(orderId) {
      let product = get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data;
      let productAfter = getAfter(productPath(request.resource.data.productId)).data;
      let quantity = request.resource.data.quantity;
      let orderName = product.get('orderName', product.name);
      let kilo = request.resource.data.get('kilo', '');
      let unitPrice = orderName == 'Whole Lechon'
        ? product.get('kiloPrices', {}).get(kilo, -1)
        : product.price;
      return request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentStatus == 'due'
        && product.active == true
        && request.resource.data.productName == product.name
        && request.resource.data.imageUrl == product.imageUrl
        && (!request.resource.data.keys().hasAny(['description']) || request.resource.data.description == product.description)
        && request.resource.data.get('food', []) == product.get('food', [])
        && (!request.resource.data.keys().hasAny(['policyAccepted'])
          || (request.resource.data.policyAccepted == true
            && request.resource.data.keys().hasAll(['policyAcceptedAt'])
            && request.resource.data.policyAcceptedAt is int
            && request.resource.data.policyAcceptedAt <= request.time.toMillis()
            && request.resource.data.policyAcceptedAt >= request.time.toMillis() - 300000))
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.pickupTime is string
        && request.resource.data.pickupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (product.get('saleType', 'regular') != 'promo'
          || (request.resource.data.pickupDate >= product.promoFrom
            && request.resource.data.pickupDate <= product.promoTo))
        && quantity <= 99
        && ((allowsDecimalQuantity(orderName)
            && (quantity is int || quantity is float)
            && quantity >= 0.01)
          || (!allowsDecimalQuantity(orderName)
            && quantity is int
            && quantity >= 1))
        && (orderName == 'Whole Lechon'
          ? (request.resource.data.keys().hasAll(['kilo'])
            && kilo is string
            && unitPrice is number
            && unitPrice >= 0)
          : !request.resource.data.keys().hasAny(['kilo']))
        && (!allowsDecimalQuantity(orderName)
          || (product.get('stock', -1) is number
            && product.get('stock', -1) >= quantity
            && productAfter.get('stock', -1) == product.stock - quantity
            && productAfter.get('lastStockOrderId', '') == orderId
            && request.resource.data.get('stockDeducted', false) == true))
        && request.resource.data.total == unitPrice * request.resource.data.quantity
        && (!request.resource.data.keys().hasAny(['downpayment']) || request.resource.data.downpayment == 0)
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis()
        && request.resource.data.createdAt >= request.time.toMillis() - 300000;
    }
    function ownerCanCancelOrder(orderId) {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.cancelledAt == request.time
        && (!allowsDecimalQuantity(resource.data.productName)
          || resource.data.get('stockDeducted', false) != true
          || !exists(productPath(resource.data.productId))
          || !allowsDecimalQuantity(get(productPath(resource.data.productId)).data.get(
            'orderName', get(productPath(resource.data.productId)).data.get('name', '')))
          || (getAfter(productPath(resource.data.productId)).data.get('stock', -1)
              == get(productPath(resource.data.productId)).data.get('stock', -1) + resource.data.quantity
            && getAfter(productPath(resource.data.productId)).data.get('lastStockOrderId', '') == orderId))
        && resource.data.createdAt is int
        && resource.data.createdAt <= request.time.toMillis()
        && request.time.toMillis() - resource.data.createdAt <= 7200000;
    }
    function deliveredOrderFieldsAreLocked() {
      return resource.data.status != 'delivered'
        || (request.resource.data.status == 'delivered'
          && request.resource.data.get('downpayment', 0) == resource.data.get('downpayment', 0)
          && (request.resource.data.get('paymentStatus', 'due') == resource.data.get('paymentStatus', 'due')
            || request.resource.data.get('paymentStatus', 'due') == 'paid'));
    }
    function deliveryRequiresFullPayment() {
      return resource.data.status == 'delivered'
        || request.resource.data.status != 'delivered'
        || request.resource.data.get('paymentStatus', 'due') == 'paid'
        || (request.resource.data.get('downpayment', 0) is number
          && request.resource.data.get('total', 0) is number
          && request.resource.data.get('downpayment', 0) >= request.resource.data.get('total', 0));
    }
    function validAdminPickupReschedule() {
      let scheduleChanged = request.resource.data.diff(resource.data).affectedKeys().hasAny(['pickupDate', 'pickupTime']);
      let productRef = productPath(resource.data.productId);
      let product = get(productRef).data;
      return !scheduleChanged
        || (request.resource.data.pickupDate is string
          && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.pickupTime is string
          && request.resource.data.pickupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && (!exists(productRef)
            || product.get('saleType', 'regular') != 'promo'
            || (request.resource.data.pickupDate >= product.promoFrom
              && request.resource.data.pickupDate <= product.promoTo)));
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && validProduct();
      allow update: if (isAdmin() && validProduct())
        || validStockDeduction(productId)
        || validStockRestock(productId);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';
      allow update: if (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role)
        || (isAdmin() && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['user', 'admin']);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validOrder(orderId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isAdmin() && validAdminPickupReschedule() && deliveredOrderFieldsAreLocked() && deliveryRequiresFullPayment()) || ownerCanCancelOrder(orderId);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if canAccessOrderMessages(orderId);
        allow create: if canAccessOrderMessages(orderId)
          && request.resource.data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'customer')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /readStates/{userId} {
        allow read: if signedIn()
          && request.auth.uid == userId
          && canAccessOrderMessages(orderId);
        allow create, update: if signedIn()
          && request.auth.uid == userId
          && canAccessOrderMessages(orderId)
          && request.resource.data.keys().hasAll(['lastReadAt'])
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt == request.time;
        allow delete: if false;
      }
    }
  }
}
